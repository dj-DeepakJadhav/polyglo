# Copy to .env and fill in. .env is gitignored — never commit real keys.
#
# The app runs WITHOUT any of these (no-credentials mode: mock providers,
# local filesystem blob store, fixture telemetry). Keys unlock real generation.

# ---------------------------------------------------------------------------
# Backblaze B2  — REQUIRED by the hackathon
# backblaze.com → Buckets → Create Bucket   (then App Keys → Add a New Application Key)
# ---------------------------------------------------------------------------
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET=polyglo
# S3-compatible endpoint shown on the bucket page, e.g. s3.us-west-004.backblazeb2.com
B2_ENDPOINT=

# ---------------------------------------------------------------------------
# NVIDIA NIM — chat, image, TTS. Free, no credit card.
# build.nvidia.com → sign up → API Keys → Generate  (key starts with "nvapi-")
# Also request the 5,000-credit upgrade — approval is not instant.
#
# NVIDIA_IMAGE_BROKEN / NVIDIA_AUDIO_BROKEN: as of 2026-07-31, re-investigated —
# image generation actually WORKS (flux.1-dev, confirmed 200 OK against the live
# API), the originally-configured primary model (flux.1-schnell) is what was
# actually dead. Audio remains confirmed dead: all 3 bundled TTS slugs plus every
# plausible current-catalog "Magpie TTS" slug variant tried 404. Chat works fine
# either way. See docs/SESSION-LOG.md task #22. Set NVIDIA_AUDIO_BROKEN=false once
# a working NVIDIA TTS model slug is found, to let the app use real NvidiaNarrator
# instead of the SimulatedNarrator fallback.
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_IMAGE_BROKEN=false
NVIDIA_AUDIO_BROKEN=true

# ---------------------------------------------------------------------------
# Google Gemini — ASR verifier for the QA gate (optional, see docs/04 §2a)
# aistudio.google.com/apikey    NOTE: a Gemini Pro *subscription* is NOT this.
#
# GEMINI_DAILY_CALL_CAP is a hard limit, not advisory — enforced by
# polyglo/qa/budget.py, persisted to disk so it survives a process restart
# within the same day. Calls past the cap raise BudgetExceeded rather than
# silently proceeding. Raise this only if you deliberately want more spend.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_DAILY_CALL_CAP=50

# ---------------------------------------------------------------------------
# OpenRouter (optional). Two independent, opt-in uses:
#
# 1. Narrator — Mistral's Voxtral TTS, real audio, a genuinely different vendor
#    from Gemini (the ASR verifier). Ranks above Gemini as narrator whenever
#    set, fixing the "verifier must not be generator" trade-off GeminiNarrator
#    carries on its own. NVIDIA is still preferred if it ever works.
# 2. Image generator — ByteDance's Seedream, real image-to-image reference
#    conditioning for cross-scene character consistency (NVIDIA's provider has
#    no such parameter). NVIDIA stays the default image generator regardless
#    of this key; set OPENROUTER_PREFER_IMAGES=true to opt in.
#
# openrouter.ai/keys
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_PREFER_IMAGES=false
# OpenRouter is genuinely pay-per-use (unlike NVIDIA's free tier) -- a hard daily
# call cap, same pattern as GEMINI_DAILY_CALL_CAP. Shared between narration and
# image generation (whichever are active).
OPENROUTER_DAILY_CALL_CAP=200

# ---------------------------------------------------------------------------
# Production safety -- the app is a single, publicly reachable instance once
# deployed, with real credentials behind it. GLOBAL_DAILY_STORY_CAP bounds the
# TOTAL number of real story-creation requests across every visitor combined,
# per day -- complementary to the per-IP rate limit in polyglo/ratelimit.py,
# which alone doesn't bound how many different visitors could each stay within
# their own allowance.
# ---------------------------------------------------------------------------
GLOBAL_DAILY_STORY_CAP=100

# ---------------------------------------------------------------------------
# Runtime tuning
# ---------------------------------------------------------------------------
# Namespaces anything shared across environments via B2 — currently the SQLite
# index snapshot key (db-snapshot/<env>/polyglo.db). Leave as "dev" locally; the
# DEPLOYED instance should set POLYGLO_ENV=prod. Without this they share one key,
# and a local run silently overwrites the story index the live site restores from.
POLYGLO_ENV=dev
POLYGLO_DATA_DIR=./data
POLYGLO_DB_PATH=./data/polyglo.db

# Optional lockdown. LEAVE EMPTY for a public/demo instance — setting it requires an
# `X-Admin-Key: <value>` header on story creation and chaos toggling, which locks out
# everyone who doesn't have it (including anyone evaluating the live app). Use it to
# deliberately close an instance down, not while the URL is meant to be usable.
# Header only: it is intentionally NOT accepted as a query parameter, since query
# strings leak into access logs, browser history, and Referer headers.
POLYGLO_ADMIN_KEY=

# QA gate thresholds — MUST be calibrated against real samples (task #18).
# These are a starting guess, not a result.
QA_WER_PASS=0.10
QA_WER_RETRY=0.25
QA_MAX_ATTEMPTS=3
